        "options": {}
      },
      "id": "99c2046b-5135-59a7-bf07-72aca364ff62",
      "name": "Worker: health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "182f7278-2974-5705-8b21-eaef92aef443",
              "leftValue": "={{ $json.runningMinutes }}",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "rightValue": 90
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "0b59e008-f000-50c1-92d5-d234e2523e6b",
