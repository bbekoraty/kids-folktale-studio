# Copy this file to .env and fill in the key for the provider you use.
# Never commit .env — it is already in .gitignore.

# Which TTS provider to use by default: google | elevenlabs
TTS_PROVIDER=google

# Google Cloud Text-to-Speech (API key with the Text-to-Speech API enabled)
GOOGLE_TTS_API_KEY=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ── n8n automation (npm run worker) ─────────────────────────────
# Shared secret between n8n and the worker:  openssl rand -hex 24
WORKER_TOKEN=
WORKER_PORT=4310
# 127.0.0.1 works with Docker Desktop on Mac. On Linux with n8n in Docker use 0.0.0.0
WORKER_HOST=127.0.0.1
# Address n8n uses to reach the worker (put in download links it receives)
WORKER_PUBLIC_BASE=http://host.docker.internal:4310
# Where the worker reaches n8n for callbacks (skips Cloudflare Access)
N8N_INTERNAL_URL=http://localhost:5678

# Rendering on the Mac worked with Chrome for Testing
RENDER_CHROME_MODE=chrome-for-testing
RENDER_CONCURRENCY=
REMOTION_BROWSER=

# Story drafts (workflow A)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# YouTube category: 1 = Film & Animation, 27 = Education
YOUTUBE_CATEGORY_ID=1
